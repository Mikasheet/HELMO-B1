        <mxCell id="oElWu4H0pP2X1ax8Xy0W-0" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Damso&lt;/b&gt;&lt;/font&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="ZXEQbbL8eVZceiZg7NJs-4">
