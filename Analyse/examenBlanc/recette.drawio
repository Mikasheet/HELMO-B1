        <mxCell id="SR6Y8gXV0ZrJ77KtM2nQ-30" value="&lt;span style=&quot;font-size: 16px;&quot;&gt;Générer des rapports&lt;/span&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Déclencheur:&lt;/div&gt;&lt;div&gt;Le gérant veut avoir une visibilité sur le fonctionnement&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Description:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Lorsque le gérant veut avoir un rapport de toutes les statistiques de l&#39;application tel que le nombre de recettes en cours d&#39;analyse ou encore le taux de recettes refusées.&lt;/div&gt;&lt;div&gt;Actrice&lt;/div&gt;&lt;div&gt;Gérant&lt;/div&gt;&lt;div&gt;Pré-condition:&lt;/div&gt;&lt;div&gt;être authentifé en tant que gérant&lt;/div&gt;&lt;div&gt;Post-Condition:&lt;/div&gt;&lt;div&gt;Le gérant est informé du fonctionnement de son entreprise CuisinezMoi&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=none;" vertex="1" parent="1">
