        <mxCell id="SR6Y8gXV0ZrJ77KtM2nQ-23" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Encoder les recettes reçues par email ou pas fax&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Déclencheur:&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;La secrétaire reçoit des recettes&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Description:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Lorsque la secrétaire reçoit des recettes par email ou par fax, elle les encodes directement dans l&#39;application&amp;nbsp;&lt;/div&gt;&lt;div&gt;Actrice&lt;/div&gt;&lt;div&gt;Secrétaire&lt;/div&gt;&lt;div&gt;Pré-condition:&lt;/div&gt;&lt;div&gt;Avoir reçu des recettes par email ou fax&lt;/div&gt;&lt;div&gt;Post-Condition:&lt;/div&gt;&lt;div&gt;La ou les recettes sont ajoutées dans l&#39;application avec l&#39;auteur&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=none;" vertex="1" parent="1">
