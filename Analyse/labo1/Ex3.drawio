        <mxCell id="I8bwj5tzpewxFWm5vUkB-23" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Système du e-learning&amp;nbsp;&lt;/font&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="370" y="40" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I8bwj5tzpewxFWm5vUkB-24" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-size:14.0pt;line-height:115%&quot;&gt;Soumettre un&lt;br&gt;ou plusieurs devoir&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Acteurs&amp;nbsp;: Étudiant&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Évènement déclencheur&amp;nbsp;&lt;span style=&quot;font-size:10.0pt;&lt;br/&gt;line-height:115%&quot;&gt;: L’étudiant doit rendre un devoir ou plusieurs dans différents&lt;br&gt;cours où il est inscrit.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Description&amp;nbsp;: &lt;span style=&quot;font-size:10.0pt;line-height:&lt;br/&gt;115%&quot;&gt;L’étudiant doit enregistrés ses devoirs dans un format accepté par l’espace&lt;br&gt;de dépôt sur un appareil capable de se connecter au système de e-learning. Une&lt;br&gt;fois connecter au système il peut déposer le ou les fichiers dans un dépôt&lt;br&gt;prévu à cet effet dans l’espace de cours.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Précondition&amp;nbsp;:&lt;span style=&quot;font-size:10.0pt;line-height:&lt;br/&gt;115%&quot;&gt;S’être authentifier avec son compte étudiant&lt;/span&gt;.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Postcondition&amp;nbsp;: &lt;span style=&quot;font-size:10.0pt;&lt;br/&gt;line-height:115%&quot;&gt;Valider le dépôt&lt;/span&gt; &lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="890" y="15" width="270" height="340" as="geometry" />
        </mxCell>
        <mxCell id="k1U2v1bUMTibtUz4N7xj-1" value="déposer du contenu pédagogique," style="ellipse;whiteSpace=wrap;html=1;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="398.75" y="460" width="198.75" height="40" as="geometry" />
        </mxCell>
        <mxCell id="k1U2v1bUMTibtUz4N7xj-3" value="" style="endArrow=none;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="I8bwj5tzpewxFWm5vUkB-4" target="k1U2v1bUMTibtUz4N7xj-1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="510" y="630" as="sourcePoint" />
            <mxPoint x="560" y="580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k1U2v1bUMTibtUz4N7xj-5" value="gérer les comptes&amp;nbsp;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="398.75" y="680" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="k1U2v1bUMTibtUz4N7xj-8" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Attribuer des rôles aux utilisateurs&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Acteurs&amp;nbsp;: Administrateur &lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Évènement déclencheur&amp;nbsp;: Enregistrement d’un nouveau&lt;br&gt;compte ou modification d’un compte déjà existant.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Description&amp;nbsp;:&amp;nbsp;Lorsqu’un nouveau compte sur la&lt;br&gt;plateforme est créé, l’admin reçoit une notification pour attribuer un rôle à&lt;br&gt;ce nouveau compte. Si le rôle attribuer est étudiant le compte sera seulement autorisé&lt;br&gt;consulté des notes ou déposé des devoirs dans un espace de cours. Si le rôle&lt;br&gt;attribué est un assisant alors, le compte aura la permission de créer ou&lt;br&gt;corriger des devoirs et déposer du contenu pédagogique. Si le rôle attribué est&lt;br&gt;un enseignant titulaire alors, le compte aura les mêmes permissions que l’assistant&lt;br&gt;et pourra en plus publier les notes et gérer les espaces en lignes. Et enfin si&lt;br&gt;le rôle attribuer est administrateur, le compte pourra attribuer des rôles,&lt;br&gt;gérer les comptes, générer des rapports d’activité et surveiller l’utilisation&lt;br&gt;de la plateforme.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Précondition&amp;nbsp;: Avoir les permissions d’administrateur&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Postcondition&amp;nbsp;:&amp;nbsp;/&amp;nbsp;&lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="720" y="400" width="445" height="354" as="geometry" />
        </mxCell>
        <mxCell id="k1U2v1bUMTibtUz4N7xj-9" value="" style="endArrow=none;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="k1U2v1bUMTibtUz4N7xj-5" target="I8bwj5tzpewxFWm5vUkB-3" edge="1">
