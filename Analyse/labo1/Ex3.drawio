        <mxCell id="k1U2v1bUMTibtUz4N7xj-32" value="&lt;p class=&quot;MsoNormal&quot;&gt;Déposer du contenu pédagogique &lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Acteurs&amp;nbsp;: Enseignant titulaire ou l’assistant &lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Évènement déclencheur&amp;nbsp;: Acquisition d’un document qu’il&lt;br&gt;faut partager&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Description&amp;nbsp;:&amp;nbsp;L’acteur principal dépose un document&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;que les étudiants doivent voir qui peut être important ou seulement à but&lt;br&gt;informatif&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Précondition&amp;nbsp;: /&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;Postcondition&amp;nbsp;:&amp;nbsp;Les étudiants reçoivent une&lt;br&gt;notification&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=none;" parent="1" vertex="1">
