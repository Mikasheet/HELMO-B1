        <mxCell id="QW_dgg-dsie90tEixdhY-23" value="Système de la bibliothèque" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="QW_dgg-dsie90tEixdhY-24" value="Gérer les rappels&lt;div&gt;Déclencheur: Le système informe la bibliothècaire d&#39;un retard&lt;/div&gt;&lt;div&gt;Description: Chaque jour, le système vérifie qu&#39;il s&#39;il n&#39;y pas une personne qui n&#39;aurai pas rendu les livres qu&#39;il a emprunté avec plis de 30 jours de retard.&lt;/div&gt;&lt;div&gt;Acteur: cheffe-bibliothécaire&lt;/div&gt;&lt;div&gt;Pré-condition: Un emprunteur n&#39;a pas rendu les livres empruntés dans le délai imparti.&lt;/div&gt;&lt;div&gt;Post-Condition: L&#39;emprunteur reçoit une lettre recommandé lui signalant qu&#39;il n&#39;a pas rendu les livres dans les délais.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="820" y="30" width="200" height="270" as="geometry" />
        </mxCell>
        <mxCell id="QW_dgg-dsie90tEixdhY-25" value="gérer les rappels" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="415" y="215" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QW_dgg-dsie90tEixdhY-26" value="" style="endArrow=none;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" target="QW_dgg-dsie90tEixdhY-25">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="230" y="200" as="sourcePoint" />
            <mxPoint x="280" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QW_dgg-dsie90tEixdhY-27" value="Encoder livre&lt;div&gt;Déclenceur: un emprunteur souhaite emprunté un livre.&lt;/div&gt;&lt;div&gt;Descritpion: Lorsqu&#39;un emprunteur emprunte un livre, il doit donné le livre a la bibliothécaire pour que celle-ci puisse l&#39;encoder à l&#39;aide du code barre spécifique au livre et le la scanneur de code barre. Une fois scanné le livre est encodé dans la base de donné comme étant &quot;emprunté&quot;.&lt;/div&gt;&lt;div&gt;Acteur: Bibliothécaire&lt;/div&gt;&lt;div&gt;Pré-Condition: Le livre doit posséder un code barre.&lt;/div&gt;&lt;div&gt;Post-Condition: Le livre est encodé dans la base de donné comme étant &quot;emprunté&quot;.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="760" y="330" width="250" height="270" as="geometry" />
        </mxCell>
